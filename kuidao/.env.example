# Copy to .env and fill in. Never commit .env.

# Database password (long and random, e.g. the output of: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# The address people use to reach Cercana (used in emails and for secure cookies)
APP_URL=http://localhost:3001
APP_PORT=3001

# Email for login codes.
#  - Testing: start with --profile mail and keep this line; read the emails at http://<host>:8025
#  - Real email: smtp://USER:PASS@smtp.your-provider.com:587 (Resend, Postmark, Gmail…)
SMTP_URL=smtp://mail:1025
MAIL_FROM="Cercana <hello@cercana.ai>"

# Optional: your domain for automatic HTTPS (--profile https), e.g. cercana.ai
SITE_ADDRESS=localhost

# Optional: Cloudflare Tunnel token (--profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Where demo requests from the homepage are emailed
ADMIN_EMAIL=

BACKUP_KEEP_DAYS=14
