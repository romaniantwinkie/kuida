# Supabase Auth (Project Settings → API).
# Required for agency and caregiver email/password accounts.
# Auth screens stay usable without these and show a setup message instead of crashing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Netlify: set the same two variables on the site and on deploy previews.
# In Supabase Auth, allow the site URL and /auth/callback as redirect URLs.
# Email confirmation can stay on. Signup then asks the person to check email before signing in.
# Optional SQL for a profiles table lives in supabase/profiles.sql. Signup stores role in user metadata either way.
